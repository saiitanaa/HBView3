{
  "name": "hbview3",
  "displayName": "HBView3",
  "description": "Nintendo 3DS preview extension for VSCode and VSCodium",
  "version": "0.1.0",
  "publisher": "saiitanaa",
  "license": "GPL-3.0-only",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:hbview3.openPreview"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hbview3.openPreview",
        "title": "HBView3: Open Preview"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/vscode": "^1.137.0",
    "typescript": "^7.0.2"
  }
}